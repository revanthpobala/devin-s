# GMAIL CONFIGURATION
GMAIL_EMAIL=your_email@gmail.com
# 16-character Google App Password (without spaces)
GMAIL_APP_PASSWORD=your_16_char_app_password

# TRADINGVIEW EMAIL CONFIGURATION
# TV usually sends emails from noreply@tradingview.com
SENDER_EMAIL=noreply@tradingview.com

# GOOGLE SHEETS CONFIGURATION
# Name of Sheet 1: TradingView Alerts Tracker
GOOGLE_SHEET_NAME=TradingView Alerts Tracker
# Name of Sheet 2: TradingView Trades Tracker (excludes index options / intraday)
GOOGLE_TRADES_SHEET_NAME=TradingView Trades Tracker
# Optional: Google Sheet ID (extracted from sheet URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit)
GOOGLE_SHEET_ID=
# Path to your Google Service Account credentials file
SERVICE_ACCOUNT_FILE=service_account.json

# ALPACA API CONFIGURATION (For news feeds and stock prices)
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
# Paper or live endpoint (e.g., https://paper-api.alpaca.markets or https://api.alpaca.markets)
# Script will dynamically translate this to data.alpaca.markets for market feeds/news
ALPACA_API_URL=https://paper-api.alpaca.markets

# LOCAL LLM CONFIGURATION (Ollama or FastAPI Unsloth Server)
# For Ollama: http://localhost:11434/api/generate
# For FastAPI Unsloth Server: http://localhost:8000/trader (or http://localhost:8000/analyze)
LOCAL_LLM_URL=http://localhost:8000/trader
LOCAL_LLM_MODEL=unsloth/llama-3-8b-Instruct

# SCRIPT MODE CONFIGURATION
# Set to 'true' to run continuously as a background process. 
# Set to 'false' to run once and exit.
LOOP_MODE=false
# Polling interval in seconds (only used if LOOP_MODE=true)
POLLING_INTERVAL=60
